# Anthropic API key for the chat agent
ANTHROPIC_API_KEY=

# Anthropic API base URL. Leave at the default unless you're proxying.
# (Some local tools — e.g. Claude Desktop — export a different ANTHROPIC_BASE_URL
# globally; setting it here ensures the dev server uses the canonical endpoint.)
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Public repo URL — used to build citation links into the KB
# Format: https://github.com/<owner>/<repo>
NEXT_PUBLIC_REPO_URL=https://github.com/Miawousha/queryme

# Default branch citations point at (typically "main")
NEXT_PUBLIC_REPO_BRANCH=main

# --- Persistence ---

# Username (GitHub login) of the "house" account served at the bare domain "/".
# Create it with `pnpm admin account create <username>` then `pnpm backfill:root`.
ROOT_ACCOUNT_USERNAME=

# Postgres connection string (Vercel Postgres / Neon)
# Get via: `vercel env pull` after linking, or from the Neon console
POSTGRES_URL=

# Upstash Redis (Vercel KV) — both required
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Password for the /admin dashboard (conversations and forwarded
# questions). Leave unset to disable admin access entirely. It also keys the
# session cookie's signature, so changing it logs every admin session out.
ADMIN_PASSWORD=

# --- Forward-question notifications ---

# Resend API key for transactional email
RESEND_API_KEY=

# Address that receives forwarded questions
FORWARD_NOTIFICATION_TO=

# Verified sender address used as the `from` (must be on a Resend-verified domain)
FORWARD_NOTIFICATION_FROM=

# --- Self-host (Docker) ---

# Use REDIS_URL for self-hosted Redis (TCP).
# When set, takes precedence over KV_REST_API_URL/KV_REST_API_TOKEN.
# Example for docker-compose: redis://redis:6379
REDIS_URL=

# --- SEO ---

# Canonical site URL used by the /sitemap.xml endpoint. Defaults to
# https://example.com if unset — set this to your real deployed URL or
# crawlers will follow a broken sitemap.
NEXT_PUBLIC_SITE_URL=
