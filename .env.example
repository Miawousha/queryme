# Anthropic API key for the chat agent
ANTHROPIC_API_KEY=

# Anthropic API base URL. Leave at the default unless you're proxying.
# (Some local tools — e.g. Claude Desktop — export a different ANTHROPIC_BASE_URL
# globally; setting it here ensures the dev server uses the canonical endpoint.)
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Public repo URL — used to build citation links into the KB
# Format: https://github.com/<owner>/<repo>
NEXT_PUBLIC_REPO_URL=https://github.com/Miawousha/queryme

# Default branch citations point at (typically "main")
NEXT_PUBLIC_REPO_BRANCH=main

# --- Persistence ---

# Username (GitHub login) of the "house" account served at the bare domain "/".
# Create it with `pnpm admin account create <username>` then `pnpm backfill:root`.
ROOT_ACCOUNT_USERNAME=

# Postgres connection string (Vercel Postgres / Neon)
# Get via: `vercel env pull` after linking, or from the Neon console
POSTGRES_URL=

# Upstash Redis (Vercel KV) — both required
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Authentication (GitHub OAuth) ---

# GitHub OAuth app credentials (https://github.com/settings/developers).
# Callback URL: {your site}/api/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# --- GitHub App (one-click content auto-sync) ---

# The App's URL slug — used to build the install link
# (e.g. "queritae" → https://github.com/apps/queritae/installations/new).
# See docs/github-app-setup.md for registration steps.
GITHUB_APP_SLUG=

# Webhook signing secret for /api/github/app. Generate: openssl rand -base64 32
GITHUB_APP_WEBHOOK_SECRET=

# Signs the session + OAuth-state cookies. Rotating it logs everyone out.
# Generate: openssl rand -base64 32
SESSION_SECRET=

# CLI-only machine login for `admin sync/status --remote`. The browser admin
# now signs in with GitHub OAuth — this password is no longer a browser login.
# Leave unset to disable remote CLI access. It also keys the remote session
# cookie's signature, so changing it logs every remote CLI session out.
ADMIN_PASSWORD=

# --- Forward-question notifications ---

# Resend API key for transactional email
RESEND_API_KEY=

# Address that receives forwarded questions
FORWARD_NOTIFICATION_TO=

# Verified sender address used as the `from` (must be on a Resend-verified domain)
FORWARD_NOTIFICATION_FROM=

# --- Quotas & spend alerting ---

# Per-account hard ceilings on paid model calls. Requests over either limit
# get a 429 before the Anthropic call. Defaults: 200 / 10,000,000.
QUOTA_DAILY_MESSAGES_PER_ACCOUNT=
QUOTA_MONTHLY_TOKENS_PER_ACCOUNT=

# Bearer token for the Vercel cron at /api/cron/usage-alert. Unset = the
# endpoint always 401s (fail closed). Generate: openssl rand -base64 32
CRON_SECRET=

# Platform-wide daily token threshold that triggers the usage-alert email.
# Default: 1,000,000.
USAGE_ALERT_DAILY_TOKENS=

# Recipient for usage alerts. Falls back to FORWARD_NOTIFICATION_TO.
USAGE_ALERT_TO=

# --- Billing (Stripe) ---

# Secret key (test mode: sk_test_..., live: sk_live_... or a restricted key).
STRIPE_SECRET_KEY=

# Signing secret for /api/stripe/webhook. From `stripe listen` locally, or the
# dashboard webhook endpoint config in production.
STRIPE_WEBHOOK_SECRET=

# The recurring $9/month Price for the Pro plan. Printed by `pnpm stripe:setup`.
STRIPE_PRO_PRICE_ID=

# --- SEO ---

# Canonical site URL used by the /sitemap.xml endpoint. Defaults to
# https://example.com if unset — set this to your real deployed URL or
# crawlers will follow a broken sitemap.
NEXT_PUBLIC_SITE_URL=

# --- Custom domains (vanity hosting) ---

# Token + project that own the deployment; used to attach/verify user domains.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
# Only for team-scoped projects:
VERCEL_TEAM_ID=
# The platform's own host — requests to it (and *.PLATFORM_HOST, *.vercel.app,
# localhost) are served normally; everything else is treated as a custom domain.
PLATFORM_HOST=queritae.com
