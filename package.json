{
  "name": "queritae",
  "version": "1.0.0",
  "description": "Queritae — a queryable CV agent. Persona content (kb + system prompt + persona.yaml) lives in an external GitHub repo and is synced from the admin Content tab; the app is a content-free shell.",
  "private": true,
  "scripts": {
    "dev": "env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL next dev",
    "build": "next build",
    "start": "env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL next start",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:kb": "tsx scripts/validate-kb.ts",
    "enrich:repo": "tsx scripts/enrich-repo.ts",
    "evals": "tsx scripts/eval.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "stripe:setup": "tsx scripts/stripe-setup.ts",
    "stripe:golive": "tsx scripts/stripe-golive.ts",
    "backfill:root": "tsx scripts/backfill-root-account.ts",
    "admin": "tsx scripts/admin-cli.ts"
  },
  "keywords": [
    "cv",
    "ai-agent",
    "next.js",
    "knowledge-base",
    "mcp"
  ],
  "author": "Alexandre Collet",
  "license": "MIT",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.79",
    "@ai-sdk/react": "^2.0.192",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@upstash/redis": "^1.38.0",
    "ai": "^5.0.190",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "next": "^15.5.18",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.2.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tar": "^7.5.15",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  }
}
