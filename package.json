{
  "name": "queryme",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "dev": "env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL next dev",
    "build": "pnpm validate:kb && next build",
    "start": "env -u ANTHROPIC_API_KEY -u ANTHROPIC_BASE_URL next start",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:kb": "tsx scripts/validate-kb.ts",
    "kb:gen-key": "tsx scripts/kb-sensitive.ts gen-key",
    "kb:encrypt": "tsx scripts/kb-sensitive.ts encrypt",
    "kb:decrypt": "tsx scripts/kb-sensitive.ts decrypt",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.33.4",
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.79",
    "@ai-sdk/react": "^2.0.192",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@neondatabase/serverless": "^1.1.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.8",
    "@tailwindcss/postcss": "^4.3.0",
    "@upstash/redis": "^1.38.0",
    "ai": "^5.0.190",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "next": "^15.5.18",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.7"
  }
